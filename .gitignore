# Python / environment
__pycache__/
*.pyc
.venv/
.DS_Store

# ---------------------------------------------------------------------------
# Local-only code. These scripts import the proprietary Visual Salsa grid
# decoder and/or handle licensed audio, so they never leave this machine.
# They live in local/; local/README.md (tracked) documents each one.
local/*
!local/README.md
get_token.md
NOTES-visualsalsa.md
# Former top-level locations of the local scripts, kept so that a copy left
# behind can never be committed by accident.
visualsalsa_grid.py
fetch_grids.py
fetch_audio.py
verify_alignment.py
stage_b_labels.py
build_features.py
build_chroma.py
stem_ablation.py
stem_when.py
amor_harmony.py
amor_harmony_period.py
bembe_stems.py
bembe_eval.py
bembe_train.py

# ---------------------------------------------------------------------------
