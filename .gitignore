data/.token
data/songs/*
data/audio/*
data/audio_frag/*
data/mels/*
data/features/*
data/chroma/*
data/explorer/*
data/ens/*
data/probe_models/*
data/bembe_models/*
data/beatmachine/*
!data/*/README.md
data/*.log
data/*.pt
data/*.zip
data/stage_b_labels.npz
data/visualsalsa_catalog.json
data/visualsalsa_free_songs.json
data/audio_status.json
data/alignment.json
data/ablation_*.json
